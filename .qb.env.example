# .qb.env.example — committed template. Copy to .qb.env (gitignored) and fill in.
#
# Run a command with these resolved into its environment:
#   op run --env-file=.qb.env -- python3 scripts/deploy_dashboard_codepages.py
#
# Values beginning with op:// are secret references, resolved at run time by the
# 1Password CLI. Format: op://<vault>/<item>/<field>
# Verify a reference resolves before relying on it:
#   op read "op://<vault>/<item>/<field>"

CHART_QUICKBASE_REALM_HOSTNAME=chartindustries.quickbase.com
CHART_QUICKBASE_APP_DBID=bg86uwfcw

# App token (the app requires app tokens). Embedded in the deployed code pages.
CHART_QUICKBASE_APP_TOKEN=op://<vault>/<item>/<app-token-field>

# Quickbase user token used by the deploy script. Secret.
CHART_QUICKBASE_USER_TOKEN=op://<vault>/<item>/<user-token-field>
